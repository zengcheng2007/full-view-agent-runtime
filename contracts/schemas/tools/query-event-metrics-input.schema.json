          "type": "string"
        },
        "metrics": {
          "items": {
            "enum": [
              "finish_rate",
              "event_count"
            ],
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/MetricQueryScope"
        },
        "group_by": {
          "items": {
            "enum": [
              "month",
              "event_category"
            ],
            "type": "string"
          },
          "maxItems": 1,
          "title": "Group By",
          "type": "array"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventMetricTimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 200,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
