      ],
      "title": "EventMetricQuerySpec",
      "type": "object"
    },
    "EventMetricTimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EventMetricTimeRange",
      "type": "object"
    },
    "MetricQueryScope": {
      "additionalProperties": false,
      "properties": {
        "area_code": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Area Code",
          "type": "string"
        },
        "include_descendants": {
          "default": true,
          "title": "Include Descendants",
          "type": "boolean"
        }
      },
      "required": [
        "area_code"
      ],
      "title": "MetricQueryScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "$ref": "#/$defs/EventMetricQuerySpec"
