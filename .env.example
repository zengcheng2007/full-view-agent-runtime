# Use "development" or "test" only for isolated local work. "production"
# fails closed unless the database, signing/encryption keys, and HTTP business
# adapter below are all configured.
FULL_VIEW_RUNTIME_PROFILE=development

# PostgreSQL is the authority store for Session, Run, Result, AuthContext,
# Event, idempotency records, pending inputs, steers, and encrypted credentials.
FULL_VIEW_DATABASE_URL=postgresql://agent_user:replace-me@127.0.0.1:15432/agent_db
FULL_VIEW_POSTGRES_SCHEMA=full_view_agent
# Official LangGraph checkpoint tables live here, never in the product ledger.
FULL_VIEW_LANGGRAPH_POSTGRES_SCHEMA=full_view_agent_langgraph

# Base64-encoded 16/24/32-byte AES-GCM key. Keep it in a secret manager in production.
FULL_VIEW_CREDENTIAL_KEY=replace-with-base64-key

# Separate HMAC key for opaque pagination cursors.
FULL_VIEW_CURSOR_KEY=replace-with-another-base64-key

# Optional cross-instance SSE wake-up bus. PostgreSQL remains authoritative.
FULL_VIEW_REDIS_URL=redis://127.0.0.1:16379/0
FULL_VIEW_REDIS_EVENT_PREFIX=full-view-agent:events
FULL_VIEW_EVENT_RETENTION_SECONDS=3600

# Existing system identity endpoint.
FULL_VIEW_LEGACY_GATEWAY_URL=http://127.0.0.1:9666

# Comma-separated user IDs explicitly authorized for the current P0 dataset
# and Tool set. Legacy numeric role values are intentionally not translated
# into Agent permissions.
FULL_VIEW_P0_ALLOWED_USER_IDS=

# Live HTTP eval reads FULL_VIEW_EVAL_GEO_TOKEN from the current process only.
# Do not persist that short-lived token in this file.

# Business Tool adapter. Keep "memory" for isolated development/tests; switch to
# "http" only when the existing gateway is reachable and real geoToken sessions are used.
FULL_VIEW_GOVERNANCE_ADAPTER=memory
FULL_VIEW_GOVERNANCE_BASE_URL=http://127.0.0.1:9666/geo-qxst
# Disabled by default. Enable only after a live production check proves the
# Chinese eventtype_code1 dictionary uniquely covers every category code
# returned by /api/getEventProperties.
FULL_VIEW_EVENT_CATEGORY_ENABLED=false
# Exact comma-separated hostnames/IPs only. Keep empty in production unless a
# reviewed Connector must reach a private service; metadata remains blocked.
FULL_VIEW_CONNECTOR_ALLOWED_PRIVATE_HOSTS=

# LangGraph is the R3 default and uses persistent PostgreSQL checkpoints when
# DATABASE_URL exists. "native" is only the time-limited rollback switch.
FULL_VIEW_ORCHESTRATOR=langgraph

# Model planning. "deterministic" keeps the fixed local-development planner.
# Production requires "openai_compatible" and the endpoint/model values below.
FULL_VIEW_MODEL_PROVIDER=deterministic
FULL_VIEW_MODEL_BASE_URL=https://replace-with-model-endpoint/v1
FULL_VIEW_MODEL_NAME=replace-with-model-name
FULL_VIEW_MODEL_API_KEY=replace-with-model-key
FULL_VIEW_MODEL_TIMEOUT_SECONDS=60
FULL_VIEW_MODEL_TOKEN_BUDGET=32000
# Optional only for an environment-fallback model. Keep this explicit instead
# of guessing behavior from a provider or model name. Managed model profiles
# configured in the Agent console take precedence for Run-pinned execution.
# FULL_VIEW_MODEL_REASONING_CAPABILITY={"mode":"hybrid","fast_profile":{"enable_thinking":false},"deep_profile":{"enable_thinking":true,"reasoning_effort":"high"}}
